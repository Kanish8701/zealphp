#!/usr/bin/env php
<?php

declare(strict_types=1);


$subCommand = $argv[1] ?? null;

// ── Valid command whitelist ───────────────────────────────────────────────
// Check before executing anything. If unknown command → show error + list.
const VALID_COMMANDS = [
    // handled by this script
    'new',
    'upgrade',
    // forwarded to php app.php (ZealPHP handles these)
    'start',
    'stop',
    'restart',
    'status',
    'logs',
    'list',
    // global flags
    '--help',
    '-h',
    '--version',
    '-V',
];

if ($subCommand !== null && !in_array($subCommand, VALID_COMMANDS, true)) {
    echo PHP_EOL;
    echo "\033[31m[ERROR]\033[0m Unknown command: \033[1m$subCommand\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "Available commands:" . PHP_EOL;
    foreach (VALID_COMMANDS as $cmd) {
        if (!str_starts_with($cmd, '-')) {
            echo "    \033[32mzealphp $cmd\033[0m" . PHP_EOL;
        }
    }
    echo PHP_EOL;
    echo "Run \033[32mzealphp\033[0m to see full usage." . PHP_EOL;
    echo PHP_EOL;
    exit(1);
}

// ── Helper functions ──────────────────────────────────────────────────────

/**
 * Read and decode the USER's project composer.json.
 * Uses getcwd() — the directory the user is standing in.
 *
 * Returns null when:
 *   - composer.json not found (user is not inside a project)
 *   - JSON is malformed / unreadable
 */

function getComposerData(): ?array
{
    $projectRoot  = getcwd();
    $composerFile = $projectRoot . '/composer.json';

    if (!file_exists($composerFile)) {
        fwrite(STDERR, PHP_EOL);
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m Composer not found in: $projectRoot" . PHP_EOL);
        fwrite(STDERR, "  Run this command from within a ZealPHP project directory, or create one:" . PHP_EOL);
        fwrite(STDERR, "  \033[32mzealphp new my-app\033[0m" . PHP_EOL);
        fwrite(STDERR, PHP_EOL);
        exit(1);
    }

    $json = file_get_contents($composerFile);
    $data = json_decode($json, true);

    if (json_last_error() !== JSON_ERROR_NONE) {
        return null;  // malformed JSON — don't crash
    }

    return $data;
}

/**
 * Read the ZealPHP version from the user's composer.json.
 * Looks under "require" → "zealphp/zealphp".
 *
 * Example composer.json:
 *   "require": { "zealphp/zealphp": "^0.4.12" }
 */

function getVersion(): string{
    $data = getComposerData();
    if($data && !empty($data["require"]["zealphp/zealphp"])){
        return $data["require"]["zealphp/zealphp"];
    }
    else
        return 'Version is not maintained in Composer.json File';
}

/**
 * Read the entry point from the user's composer.json.
 * Looks under "server" → "entry-point".
 *
 * Example composer.json:
 *   "serve": {
 *           "entry-point": "server.php"
 *   }
 */

function getEntryPoint(): String{
       $data = getComposerData();
        if($data && !empty($data["serve"]["entry-point"]) ){
            return $data["serve"]["entry-point"];
        }
        else{
            fwrite(STDERR, PHP_EOL);
            fwrite(STDERR, "  \033[31m[ERROR]\033[0m Entry Point is missing or empty in Composer.json File" . PHP_EOL);
            fwrite(STDERR, PHP_EOL);
            fwrite(STDERR, "  Fix by adding to your composer.json:" . PHP_EOL);
            fwrite(STDERR, "    \033[90m    \"serve\": {\033[0m" . PHP_EOL);
            fwrite(STDERR, "    \033[90m        \"entry-point\":  \"app.php\" " . PHP_EOL);
            fwrite(STDERR, "    \033[90m    }\033[0m" . PHP_EOL);
            fwrite(STDERR, PHP_EOL);
            exit(1);
        }
}

/**
 * Read the actually INSTALLED version of zealphp/zealphp from
 * vendor/composer/installed.json (the source of truth after `composer install`).
 */
function getInstalledVersion(): ?string
{

    $projectRoot  = getcwd();
    $installedFile = $projectRoot . '/vendor/composer/installed.json';;

    if (!file_exists($installedFile)) {
        fwrite(STDERR, PHP_EOL);
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m ZealPHP project not found: $projectRoot" . PHP_EOL);
        fwrite(STDERR, "  Run this command from within a ZealPHP project directory." . PHP_EOL);
        fwrite(STDERR, PHP_EOL);
        exit(1);
    }
   

    $json = file_get_contents($installedFile);
    $data = json_decode($json, true);

    if (json_last_error() !== JSON_ERROR_NONE) {
        return null;
    }

    // Composer 2.x nests packages under "packages"; older installed.json is a flat list.
    $packages = $data['packages'] ?? $data;

    if (!is_array($packages)) {
        return null;
    }

    foreach ($packages as $package) {
        if (($package['name'] ?? '') === 'zealphp/zealphp') {
            return ltrim((string) ($package['version'] ?? ''), 'v') ?: null;
        }
    }

    return null;
}

/**
 * Fetch a URL's body. Prefers curl, falls back to file_get_contents.
 * Returns null on any failure — never throws, never crashes the CLI.
 */
function fetchUrl(string $url): ?string
{
    if (function_exists('curl_init')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT        => 10,
            CURLOPT_USERAGENT      => 'zealphp-cli',
            CURLOPT_FOLLOWLOCATION => true,
        ]);
        $body = curl_exec($ch);
        $ok   = $body !== false && curl_getinfo($ch, CURLINFO_HTTP_CODE) === 200;
        curl_close($ch);

        return $ok ? $body : null;
    }

    if (ini_get('allow_url_fopen')) {
        $context = stream_context_create([
            'http' => ['timeout' => 10, 'header' => "User-Agent: zealphp-cli\r\n"],
        ]);
        $body = @file_get_contents($url, false, $context);

        return $body !== false ? $body : null;
    }

    return null;
}

/**
 * Fetch the latest stable version of a package from Packagist.
 * Skips dev branches and pre-release tags (alpha/beta/RC).
 */
function fetchLatestVersion(string $package): ?string
{
    $body = fetchUrl("https://repo.packagist.org/p2/{$package}.json");

    if ($body === null) {
        return null;
    }

    $data = json_decode($body, true);

    if (json_last_error() !== JSON_ERROR_NONE) {
        return null;
    }

    $entries = $data['packages'][$package] ?? [];
    $stable  = [];

    foreach ($entries as $entry) {
        $version = ltrim((string) ($entry['version'] ?? ''), 'v');

        if ($version === '' || str_starts_with($version, 'dev-') || str_ends_with($version, '-dev')) {
            continue; // dev branches
        }
        if (preg_match('/-(alpha|beta|rc)/i', $version)) {
            continue; // pre-releases
        }

        $stable[] = $version;
    }

    if (empty($stable)) {
        return null;
    }

    usort($stable, fn($a, $b) => version_compare($b, $a));

    return $stable[0];
}

/**
 * Check whether a string looks like a real semantic version,
 * e.g. 1.2.3, 0.4.12, 2.0.0-beta1. Rejects garbage like "banana" or "9999".
 */
function isValidVersion(string $version): bool
{
    return (bool) preg_match('/^\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?$/', $version);
}

/**
 * Prompt the user with a yes/no question. Defaults to "No" on empty input.
 */
function confirm(string $message): bool
{
    echo $message . ' [Yes/No]: ';

    $handle = fopen('php://stdin', 'r');
    $line   = $handle ? fgets($handle) : false;

    if ($handle) {
        fclose($handle);
    }

    $answer = strtolower(trim((string) $line));

    return $answer === 'y' || $answer === 'yes';
}

/**
 * Print the ZealPHP ASCII header.
 */

 function printHeader(): void{
    echo PHP_EOL;
    echo "\033[36;1m ______          _  ____  _   _ ____  \033[0m" . PHP_EOL;
    echo "\033[36;1m|__  / ___  __ _| ||  _ \| | | |  _ \ \033[0m" . PHP_EOL;
    echo "\033[36;1m  / / / _ \/ _\ | || |_) | |_| | |_) |\033[0m" . PHP_EOL;
    echo "\033[36;1m / /_|  __/ (_| | ||  __/|  _  |  __/ \033[0m" . PHP_EOL;
    echo "\033[36;1m/____|\___|\__,_|_||_|   |_| |_|_|    \033[0m" . PHP_EOL;
    echo PHP_EOL;
    
}

/**
 * Print the styled command list.
 */

function printList(): void{

    echo "\033[1m  Usage:\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp\033[0m \033[33m[command]\033[0m \033[90m[options]\033[0m" . PHP_EOL;
    echo PHP_EOL;

    echo "\033[1m  Project:\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp new \033[33m<name>\033[0m" . PHP_EOL;
    echo "    \033[90m  Scaffold a new ZealPHP project\033[0m" . PHP_EOL;
    echo PHP_EOL;

    echo "\033[1m  Server:\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp start\033[0m" . PHP_EOL;
    echo "    \033[90m  Start the server on port 8080 (foreground)\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp start \033[90m--dev\033[0m" . PHP_EOL;
    echo "    \033[90m  Start with route hot-reload enabled\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp start \033[90m-p 9501 -d\033[0m" . PHP_EOL;
    echo "    \033[90m  Start daemonized on port 9501\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp stop\033[0m" . PHP_EOL;
    echo "    \033[90m  Stop the server on default port\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp stop \033[90m-p 9501\033[0m" . PHP_EOL;
    echo "    \033[90m  Stop the server on port 9501\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp restart\033[0m" . PHP_EOL;
    echo "    \033[90m  Restart the server\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp status\033[0m" . PHP_EOL;
    echo "    \033[90m  Check if the server is running\033[0m" . PHP_EOL;
    echo PHP_EOL;

    echo "\033[1m  Logs:\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp logs\033[0m" . PHP_EOL;
    echo "    \033[90m  Tail all log files in real-time\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[32mzealphp logs \033[90m--access --debug\033[0m" . PHP_EOL;
    echo "    \033[90m  Tail specific log files\033[0m" . PHP_EOL;
    echo PHP_EOL;

    echo "  \033[90mRun \033[32mzealphp --help\033[90m for full usage.\033[0m" . PHP_EOL;
    echo PHP_EOL;
}

/**
 * Print the welcome message shown when zealphp is run with no args.
 */

function print_welcome_message(): void{
    echo PHP_EOL;

    echo "\033[32m========================================================================\033[0m" . PHP_EOL;
    echo "\033[33mWelcome to ZealPHP - An open-source PHP framework powered by OpenSwoole\033[0m" . PHP_EOL;
    echo "\033[32m========================================================================\033[0m" . PHP_EOL;

    echo PHP_EOL;

    echo "\033[35m ZealPHP offers a lightweight, high-performance alternative to Next.js,\033[0m" . PHP_EOL;
    echo "\033[35m leveraging OpenSwoole's asynchronous I/O to perform everything Next.js can and much more.\033[0m" . PHP_EOL;
    echo "\033[35m Unlock the full potential of PHP with ZealPHP and OpenSwoole's speed and scalability!\033[0m" . PHP_EOL;

    echo PHP_EOL;

    echo "\033[1m  Features:\033[0m" . PHP_EOL;
    echo PHP_EOL;
    echo "    \033[37m1. Dynamic HTML Streaming with APIs and Sockets\033[0m" . PHP_EOL;
    echo "    \033[37m2. Parallel Data Fetching and Processing (Use go() to run async coroutine)\033[0m" . PHP_EOL;
    echo "    \033[37m3. Dynamic Routing Tree with Implicit Routes for Public and API\033[0m" . PHP_EOL;
    echo "    \033[37m4. Programmable and Injectable Routes for Authentication\033[0m" . PHP_EOL;
    echo "    \033[37m5. Dynamic and Nested Templating and HTML Rendering\033[0m" . PHP_EOL;
    echo "    \033[37m6. Workers, Tasks and Processes\033[0m" . PHP_EOL;
    echo "    \033[37m7. All PHP Superglobals are constructed per request\033[0m" . PHP_EOL;

    echo PHP_EOL;
    echo "\033[31m For more information, visit: https://php.zeal.ninja\033[0m" . PHP_EOL;

    echo PHP_EOL;
}


// ── zealphp welcome message ────────────────────────────────────────────────────

if ($subCommand === null) {
    printHeader();
    print_welcome_message();
    exit(0);
}

// ── zealphp list ────────────────────────────────────────────────────

if ($subCommand === 'list') {
    printHeader();
    printList();
    exit(0);
}

// ── zealphp Version ────────────────────────────────────────────────────

if($subCommand === '-V' || $subCommand === '--version'){
    echo "ZealPHP Version :" . getVersion() . PHP_EOL;
    exit(0);
}

// ── zealphp new <name> ────────────────────────────────────────────────────
if ($subCommand === 'new') {
    $name = $argv[2] ?? null;

    if ($name === null || $name === '') {
        fwrite(STDERR, PHP_EOL);
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m Project name is required." . PHP_EOL);
        fwrite(STDERR, "  Usage: \033[32mzealphp new <name>\033[0m" . PHP_EOL);
        fwrite(STDERR, PHP_EOL);
        exit(1);
    }

    if (!preg_match('/^[a-zA-Z0-9_\-]+$/', $name)) {
        fwrite(STDERR, PHP_EOL);
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m Invalid project name: \"$name\"" . PHP_EOL);
        fwrite(STDERR, "  Use only letters, numbers, hyphens, and underscores." . PHP_EOL);
        fwrite(STDERR, PHP_EOL);
        exit(1);
    }

    if (is_dir(getcwd() . '/' . $name)) {
        fwrite(STDERR, PHP_EOL);
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m Directory already exists: $name" . PHP_EOL);
        fwrite(STDERR, PHP_EOL);
        exit(1);
    }

    echo PHP_EOL;
    echo "  \033[33m→\033[0m  Creating new ZealPHP project: \033[1m$name\033[0m" . PHP_EOL;
    echo PHP_EOL;

    // composer create-project zealphp/zealphp-project <name>
    $cmd = ['composer', 'create-project', 'zealphp/project', $name];

    $process = proc_open($cmd, [STDIN, STDOUT, STDERR], $pipes);

    if (!is_resource($process)) {
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m Failed to run composer." . PHP_EOL);
        exit(1);
    }

    $exitCode = proc_close($process);

    echo PHP_EOL;

    if ($exitCode !== 0) {
        fwrite(STDERR, "  \033[31m✖\033[0m  Project creation failed." . PHP_EOL);
        echo PHP_EOL;
        exit($exitCode);
    }

    echo "  \033[32m✔\033[0m  Project \033[1m$name\033[0m created successfully!" . PHP_EOL;
    echo PHP_EOL;
    echo "  \033[90mNext steps:\033[0m" . PHP_EOL;
    echo "    \033[32mcd $name\033[0m" . PHP_EOL;
    echo "    \033[32mzealphp start\033[0m" . PHP_EOL;
    echo PHP_EOL;

    exit(0);
}

// ── zealphp upgrade [version] ─────────────────────────────────────────────
if ($subCommand === 'upgrade') {
    $requestedVersion = $argv[2] ?? null;
    $installedVersion = getInstalledVersion();  // null if not installed yet

    echo PHP_EOL;

    if ($requestedVersion !== null) {
        // ── Version passed → check upgrade vs downgrade, confirm ──────────
        $targetVersion = ltrim($requestedVersion, 'v');

        if (!isValidVersion($targetVersion)) {
            fwrite(STDERR, "  \033[31m[ERROR]\033[0m \"$requestedVersion\" doesn't look like a valid version." . PHP_EOL);
            fwrite(STDERR, "  Expected a format like \033[33m1.2.3\033[0m or \033[33m0.4.12\033[0m." . PHP_EOL);
            echo PHP_EOL;
            exit(1);
        }

        if ($installedVersion !== null) {
            $cmp = version_compare($targetVersion, $installedVersion);

            if ($cmp === 0) {
                echo "  Installed version:  \033[90m$installedVersion\033[0m" . PHP_EOL;
                echo "  Requested version:   \033[90m$targetVersion\033[0m" . PHP_EOL;
                echo PHP_EOL;
                $proceed = confirm("  \033[33m?\033[0m  This is already the installed version. Reinstall it anyway?");
            } elseif ($cmp > 0) {
                echo "  \033[33m→\033[0m  This will \033[1mupgrade\033[0m zealphp/zealphp:" . PHP_EOL;
                echo "      \033[90m$installedVersion\033[0m  →  \033[32m$targetVersion\033[0m" . PHP_EOL;
                echo PHP_EOL;
                $proceed = confirm('  Proceed with the upgrade?');
            } else {
                echo "  \033[33m⚠\033[0m  This will \033[1mdowngrade\033[0m zealphp/zealphp:" . PHP_EOL;
                echo "      \033[90m$installedVersion\033[0m  →  \033[31m$targetVersion\033[0m" . PHP_EOL;
                echo PHP_EOL;
                $proceed = confirm('  Proceed with the downgrade?');
            }
        } else {
            echo "  \033[33m→\033[0m  Installing zealphp/zealphp: \033[1m$targetVersion\033[0m" . PHP_EOL;
            echo PHP_EOL;
            $proceed = confirm('  Proceed?');
        }
    } else {
        // ── No version passed → look up latest, confirm ────────────────────
        echo "  \033[33m→\033[0m  Checking latest ZealPHP version..." . PHP_EOL;
        echo PHP_EOL;

        $targetVersion = fetchLatestVersion('zealphp/zealphp');

        if ($targetVersion === null) {
            fwrite(STDERR, "  \033[31m[ERROR]\033[0m Could not reach Packagist to check for updates." . PHP_EOL);
            fwrite(STDERR, "  Check your internet connection and try again." . PHP_EOL);
            echo PHP_EOL;
            exit(1);
        }

        echo "  Installed:  \033[90m" . ($installedVersion ?? 'none') . "\033[0m" . PHP_EOL;
        echo "  Latest:     \033[32m$targetVersion\033[0m" . PHP_EOL;
        echo PHP_EOL;

        if ($installedVersion !== null && version_compare($installedVersion, $targetVersion, '>=')) {
            echo "  \033[32m✔\033[0m  ZealPHP is already up to date." . PHP_EOL;
            echo PHP_EOL;
            exit(0);
        }

        $proceed = confirm('  Update to the latest version?');
    }

    echo PHP_EOL;

    if (!$proceed) {
        echo "  Aborted. No changes were made." . PHP_EOL;
        echo PHP_EOL;
        exit(0);
    }

    // ── Run composer require ───────────────────────────────────────────────
    echo "  \033[33m→\033[0m  Updating the zealphp : $targetVersion\033[0m..." . PHP_EOL;
    echo PHP_EOL;

    $cmd     = ['composer', 'require', "zealphp/zealphp:$targetVersion"];
    $process = proc_open($cmd, [STDIN, STDOUT, STDERR], $pipes);

    if (!is_resource($process)) {
        fwrite(STDERR, "  \033[31m[ERROR]\033[0m Failed to run composer." . PHP_EOL);
        exit(1);
    }

    $exitCode = proc_close($process);
    echo PHP_EOL;

    if ($exitCode !== 0) {
        fwrite(STDERR, "  \033[31m✖\033[0m  composer require failed." . PHP_EOL);
        echo PHP_EOL;
        exit($exitCode);
    }

    echo "  \033[32m✔\033[0m  ZealPHP is now on \033[1m$targetVersion\033[0m." . PHP_EOL;
    echo PHP_EOL;

    exit(0);
}

// ── start, stop, restart, status, logs → forward to entry point ──────────
$projectRoot = getcwd();
$entryPoint = getEntryPoint();
$fileEntryPoint  = $projectRoot . '/' . $entryPoint;

if (!file_exists($fileEntryPoint)) {
    fwrite(STDERR, PHP_EOL);
    fwrite(STDERR, "  \033[31m[ERROR]\033[0m $entryPoint not found in: $projectRoot" . PHP_EOL);
    fwrite(STDERR, "  Run from inside a ZealPHP project, or create one:" . PHP_EOL);
    fwrite(STDERR, "  \033[32mzealphp new my-app\033[0m" . PHP_EOL);
    fwrite(STDERR, PHP_EOL);
    exit(1);
}

// Drop argv[0] ('zealphp'), keep everything the user typed
$userArgs = array_slice($argv, 1);

// Replace this process with php app.php — zero overhead, same PID
if (function_exists('pcntl_exec')) {
    pcntl_exec(PHP_BINARY, [$fileEntryPoint, ...$userArgs]);
}

// Fallback when pcntl not available
$process = proc_open(
    [PHP_BINARY, $fileEntryPoint, ...$userArgs],
    [STDIN, STDOUT, STDERR],
    $pipes
);

exit(is_resource($process) ? proc_close($process) : 1);
